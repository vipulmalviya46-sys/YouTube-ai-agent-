# --- Brain: fill in ONE of these (free option: Gemini key from aistudio.google.com) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- YouTube (Google Cloud project with YouTube Data API v3 enabled) ---
YOUTUBE_API_KEY=                     # read-only research (no OAuth needed)
YOUTUBE_CLIENT_SECRETS=client_secret.json   # OAuth desktop client, for upload/comments

# --- Voice (optional; edge-tts is free and needs no key) ---
ELEVENLABS_API_KEY=

# --- Footage (optional; free key from pexels.com/api) ---
PEXELS_API_KEY=

# --- Social distribution (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
